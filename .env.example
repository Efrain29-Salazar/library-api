# Copia este archivo como .env y reemplaza los valores. El archivo .env NUNCA se sube a GitHub.

# Puerto del servidor
PORT=3000

# PostgreSQL (formato: postgresql://usuario:contraseña@servidor:puerto/base)
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/biblioteca_dev

# Base de datos SEPARADA para las pruebas de integración (se vacía en cada prueba)
TEST_DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/biblioteca_dev_test
